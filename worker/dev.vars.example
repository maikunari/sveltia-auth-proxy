# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Who may sign in (comma-separated Google account emails)
ALLOWED_EMAILS=editor@example.com,seo@example.com

# Where the token may be sent back to (comma-separated origins, no path)
ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,https://www.example.com

# The one repository the CMS edits, and a fine-grained PAT scoped to it
GITHUB_REPO=owner/repo
GITHUB_PAT=github_pat_your-fine-grained-token
